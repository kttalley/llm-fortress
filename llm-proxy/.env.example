# Server-side only. Copy to llm-proxy/.env (gitignored) on the host that runs the proxy.

# Ollama's OpenAI-compatible chat endpoint and model
OLLAMA_URL=http://127.0.0.1:11434/v1/chat/completions
OLLAMA_MODEL=qwen3-4b-4k:latest

# Optional header sent to the upstream, so the GPU host's nginx can reject
# anything that didn't come through this proxy. Format "Header-Name: value".
# UPSTREAM_AUTH_HEADER=X-Proxy-Token: change-me

# Optional Groq fallback (key stays on the server)
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant

PORT=8787
HOST=127.0.0.1
MAX_CONCURRENT=4
MAX_QUEUE=8
QUEUE_TIMEOUT_MS=4000
UPSTREAM_TIMEOUT_MS=60000
RATE_PER_MINUTE=60
RATE_BURST=20
# Set to 1 when behind nginx so the client IP comes from X-Real-IP / X-Forwarded-For
TRUST_PROXY=1
ALLOWED_ORIGINS=https://design.kristiantalley.com,http://localhost:5173,http://localhost:4173
