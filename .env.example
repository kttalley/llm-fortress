# Browser build config. Everything here is PUBLIC: Vite inlines VITE_* values
# into the client bundle. Never put a secret or an inference URL here.
# Inference settings live server-side in llm-proxy/.env.

# Optional: override the proxy base path (default: <base>/api, i.e. /projects/llm-fortress/api)
# VITE_LLM_PROXY_URL=/projects/llm-fortress/api
